# Copy to .env.local and fill in.
# Local Supabase: printed by `supabase status`. Hosted: dashboard → Project Settings → API.
# The app runs in Docker, so a local Supabase is reached through host.docker.internal,
# not 127.0.0.1.
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
